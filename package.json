{
  "name": "tokemonworld",
  "version": "0.0.205",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --ssl true",
    "start 4201": "ng serve --ssl true --port 4201",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "deploy": "npm version patch && ng build --aot --output-hashing=none --source-map=true --optimization=false --configuration development && gh-pages -d ./dist/tokemonworld --repo https://github.com/f80dev/tokenworld.git -f -t true -b gh-pages -m \"update from gh-pages\"",
    "deploy-prod": "npm version patch && ng build --aot --output-hashing=none --source-map=false --optimization=true --configuration production && gh-pages -d ./dist/tokemonworld --repo https://github.com/f80dev/TokemonWorldProduction.git -f -t true -b main -m \"update from main\"",
    "deploy-devnet": "npm version patch && ng build --aot --output-hashing=none --source-map=false --optimization=true --configuration devnet && gh-pages -d ./dist/tokemonworld --repo https://github.com/f80dev/TokemonWorldDevnet.git -f -t true -b main -m \"update from main\"",
    "test": "ng test"
  },
  "private": true,
  "dependencies": {
    "@abacritt/angularx-social-login": "^2.2.0",
    "@angular/animations": "20.1.3",
    "@angular/cdk": "20.1.3",
    "@angular/common": "20.1.3",
    "@angular/compiler": "20.1.3",
    "@angular/core": "20.1.3",
    "@angular/forms": "^20.1.3",
    "@angular/material": "20.1.3",
    "@angular/platform-browser": "20.1.3",
    "@angular/platform-browser-dynamic": "20.1.3",
    "@angular/router": "20.1.3",
    "@angular/service-worker": "20.1.3",
    "@multiformats/base-x": "^4.0.1",
    "@multiversx/sdk-core": "15.0.0",
    "@multiversx/sdk-extension-provider": "^5.0.0",
    "@multiversx/sdk-native-auth-client": "^2.0.1",
    "@multiversx/sdk-network-providers": "^2.9.3",
    "@multiversx/sdk-wallet": "^4.6.0",
    "@multiversx/sdk-wallet-connect-provider": "^6.0.2",
    "@multiversx/sdk-web-wallet-provider": "^5.0.0",
    "@mysten/sui": "^1.37.1",
    "@octokit/rest": "^21.0.0",
    "@tusky-io/ts-sdk": "^0.29.0",
    "@types/chrome": "^0.0.304",
    "@types/leaflet": "^1.9.14",
    "@types/proj4": "^2.5.5",
    "ang-jsoneditor": "^4.0.1",
    "angularx-qrcode": "^19.0.0",
    "base32-encode": "^2.0.0",
    "ethers": "^6.13.5",
    "image-js": "^0.30.3",
    "ipfs-http-client": "^60.0.1",
    "jsoneditor": "^10.1.3",
    "jsqr": "^1.4.0",
    "leaflet": "^1.9.4",
    "multiformats": "^13.3.2",
    "ng-navigator-share": "^1.0.4",
    "ng-qrcode": "^18.0.0",
    "ngx-socket-io": "^4.7.0",
    "ngx-webcam": "^0.4.1",
    "protobufjs": "^7.4.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "web-push": "^3.6.7",
    "zone.js": "^0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^20.1.3",
    "@angular/cli": "^20.1.3",
    "@angular/compiler-cli": "^20.1.3",
    "@types/jasmine": "~5.1.0",
    "jasmine-core": "~5.2.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "^5.8.3"
  },
  "browser": {
    "crypto": false,
    "fs": false,
    "path": false,
    "os": false,
    "stream": false
  }
}
